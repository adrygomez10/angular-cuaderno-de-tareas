{
  "name": "curso-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" angular.json \"tsconfig*.json\" package.json eslint.config.mjs",
    "check": "npm run format:check && npm run lint && npm test -- --watch=false && npm run build",
    "serve:ssr:curso-angular": "node dist/curso-angular/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jsdom": "^30.0.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.0.0"
  }
}
